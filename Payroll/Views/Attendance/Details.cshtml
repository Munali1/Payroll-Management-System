@using Newtonsoft.Json

@model IEnumerable<Payroll.Domain.Entities.Attendence>

@{
    ViewData["Title"] = "Attendance List";

   
    var groupedData = Model
        .Where(a => a.inTime.HasValue && a.outTime.HasValue)
        .GroupBy(a => new
        {
          
            Date = a.inTime.Value.Date
        })
        .Select(g => new
        {
           
            Date = g.Key.Date,
            InTime = g.Min(x => x.inTime),
            OutTime = g.Max(x => x.outTime),
            TotalWorkingHours = TimeSpan
                .FromHours(g.Sum(x => x.workingHours.HasValue ? x.workingHours.Value.TotalHours : 0))
                .ToString(@"hh\:mm")
        }).ToList();

    var currentMonthDays = groupedData
        .Where(g => g.Date.Month == DateTime.Now.Month && g.Date.Year == DateTime.Now.Year)
        .Select(g => g.Date)
        .Distinct()
        .Count();
    int totalDays = DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month);
    int absentDays = totalDays - currentMonthDays;

    var chartData = new
    {
        labels = new[] { "Present", "Absent" },
        values = new[] { currentMonthDays, absentDays }
    };
}

<div class="container mt-4">
    <h2 class="text-center">@ViewData["Title"]</h2>

    <div class="mb-4 text-center" style="display: flex; justify-content: center;">
        <canvas id="attendanceChart" width="250" height="250"></canvas>
    </div>

    <div id="gridContainer"></div>
</div>

<script>
    const chartData = @Html.Raw(JsonConvert.SerializeObject(chartData));

    const ctx = document.getElementById('attendanceChart').getContext('2d');
    const attendanceChart = new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: chartData.labels,
            datasets: [{
                label: 'Attendance Overview',
                data: chartData.values,
                backgroundColor: ['#4CAF50', '#F44336'],
                borderColor: ['#388E3C', '#D32F2F'],
                borderWidth: 1
            }]
        },
        options: {
            responsive: false,
            maintainAspectRatio: false,
            layout: { padding: 10 },
            plugins: {
                legend: { position: 'bottom' },
                title: {
                    display: true,
                    text: 'Monthly Attendance Overview'
                }
            }
        }
    });
</script>

<script>
    $(function () {
        var attendenceData = @Html.Raw(JsonConvert.SerializeObject(groupedData));

        $("#gridContainer").dxDataGrid({
            dataSource: attendenceData,
            keyExpr: "Date",
            columnAutoWidth: true,
            showBorders: true,
            filterRow: { visible: true },
            searchPanel: { visible: true, width: 240, placeholder: "Search..." },
            export: {
                enabled: true,
                fileName: "Attendance_List",
                allowExportSelectedData: true
            },
            onExporting: function (e) {
                var workbook = new ExcelJS.Workbook();
                var worksheet = workbook.addWorksheet("Attendance List");
                DevExpress.excelExporter.exportDataGrid({
                    component: e.component,
                    worksheet: worksheet,
                    autoFilterEnabled: true
                }).then(() => {
                    workbook.xlsx.writeBuffer().then((buffer) => {
                        saveAs(new Blob([buffer], { type: "application/octet-stream" }), "Attendance_List.xlsx");
                    });
                });
                e.cancel = true;
            },
            toolbar: {
                items: [{
                    widget: "dxButton",
                    options: {
                        icon: "exportxlsx",
                        text: "Export to Excel",
                        onClick: function () {
                            var dataGrid = $("#gridContainer").dxDataGrid("instance");
                            var workbook = new ExcelJS.Workbook();
                            var worksheet = workbook.addWorksheet("Attendance List");
                            DevExpress.excelExporter.exportDataGrid({
                                component: dataGrid,
                                worksheet: worksheet,
                                autoFilterEnabled: true
                            }).then(() => {
                                workbook.xlsx.writeBuffer().then((buffer) => {
                                    saveAs(new Blob([buffer], { type: "application/octet-stream" }), "Attendance_List.xlsx");
                                });
                            });
                        }
                    }
                }]
            },
            columns: [
                {
                    caption: "No", width: 50,
                    cellTemplate: function (container, options) {
                        container.text(options.rowIndex + 1);
                    }
                },
                { caption: "Date", dataField: "Date", dataType: "date" },
                { caption: "In Time", dataField: "InTime", dataType: "datetime" },
                { caption: "Out Time", dataField: "OutTime", dataType: "datetime" },
                { caption: "Total Working Hours", dataField: "TotalWorkingHours" }
            ]
        });
    });
</script>
