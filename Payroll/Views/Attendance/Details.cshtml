@using Newtonsoft.Json
@model IEnumerable<Payroll.Domain.Entities.Attendence>

@{
    ViewData["Title"] = "Attendance List";

    int year = DateTime.Now.Year;
    int month = DateTime.Now.Month;
    DateTime startDate = new DateTime(year, month, 1);
    DateTime today = DateTime.Today;
    int totalDays = DateTime.DaysInMonth(year, month);
    DateTime endDate = new DateTime(year, month, totalDays);
    DateTime validEndDate = today < endDate ? today : endDate;
    int totalCountableDays = (validEndDate - startDate).Days + 1;

    var workingDates = Enumerable.Range(0, totalCountableDays)
        .Select(offset => startDate.AddDays(offset))
        .Where(date => date.DayOfWeek != DayOfWeek.Saturday && date.DayOfWeek != DayOfWeek.Sunday)
        .ToList();
    var groupedData = Model
        .Where(a => a.inTime.HasValue && a.outTime.HasValue)
        .GroupBy(a => a.inTime.Value.Date)
        .Select(g => new
        {
            Date = g.Key,
            InTime = g.Min(x => x.inTime),
            OutTime = g.Max(x => x.outTime),
            TotalWorkingHours = TimeSpan
                .FromHours(g.Sum(x => x.workingHours.HasValue ? x.workingHours.Value.TotalHours : 0))
                .ToString(@"hh\:mm")
        }).ToList();

    var presentDates = groupedData
        .Where(g => g.Date <= validEndDate)
        .Select(g => g.Date)
        .Distinct()
        .ToList();

    var absentDates = workingDates.Except(presentDates).ToList();

    int weekendDays = totalCountableDays - workingDates.Count;
    int workingDays = workingDates.Count;
    int currentMonthDays = presentDates.Count;
    int absentDays = absentDates.Count;

    var chartData = new
    {
        labels = new[] { "Present", "Absent" },
        values = new[] { currentMonthDays, absentDays }
    };
}

<div class="container mt-4">
    <h2 class="text-center">@ViewData["Title"]</h2>
    <div class="row mb-3 text-center">
        <div class="col">
            <div class="card shadow-sm p-3">
                <strong>Total Days:</strong> @totalDays
            </div>
        </div>
        <div class="col">
            <div class="card shadow-sm p-3">
                <strong>Weekends:</strong> @weekendDays
            </div>
        </div>
        <div class="col">
            <div class="card shadow-sm p-3">
                <strong>Working Days:</strong> @workingDays
            </div>
        </div>
        <div class="col">
            <div class="card shadow-sm p-3 text-success">
                <strong>Present:</strong> @currentMonthDays
            </div>
        </div>
        <div class="col">
            <div class="card shadow-sm p-3 text-danger">
                <strong>Absent:</strong> @absentDays
            </div>
        </div>
    </div>

    <div class="mb-4 text-center" style="display: flex; justify-content: center;">
        <canvas id="attendanceChart" width="250" height="250"></canvas>
    </div>

    <div id="gridContainer"></div>
</div>

<script>
    const chartData = @Html.Raw(JsonConvert.SerializeObject(chartData));

    const ctx = document.getElementById('attendanceChart').getContext('2d');
    const attendanceChart = new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: chartData.labels,
            datasets: [{
                label: 'Attendance Overview',
                data: chartData.values,
                backgroundColor: ['#4CAF50', '#F44336'],
                borderColor: ['#388E3C', '#D32F2F'],
                borderWidth: 1
            }]
        },
        options: {
            responsive: false,
            maintainAspectRatio: false,
            layout: { padding: 10 },
            plugins: {
                legend: { position: 'bottom' },
                title: {
                    display: true,
                    text: 'Monthly Attendance Overview'
                }
            }
        }
    });
</script>

<script>
    $(function () {
        var attendenceData = @Html.Raw(JsonConvert.SerializeObject(groupedData));

        $("#gridContainer").dxDataGrid({
            dataSource: attendenceData,
            keyExpr: "Date",
            columnAutoWidth: true,
            showBorders: true,
            filterRow: { visible: true },
            searchPanel: { visible: true, width: 240, placeholder: "Search..." },
            export: {
                enabled: true,
                fileName: "Attendance_List",
                allowExportSelectedData: true
            },
            onExporting: function (e) {
                var workbook = new ExcelJS.Workbook();
                var worksheet = workbook.addWorksheet("Attendance List");
                DevExpress.excelExporter.exportDataGrid({
                    component: e.component,
                    worksheet: worksheet,
                    autoFilterEnabled: true
                }).then(() => {
                    workbook.xlsx.writeBuffer().then((buffer) => {
                        saveAs(new Blob([buffer], { type: "application/octet-stream" }), "Attendance_List.xlsx");
                    });
                });
                e.cancel = true;
            },
            toolbar: {
                items: [{
                    widget: "dxButton",
                    options: {
                        icon: "exportxlsx",
                        text: "Export to Excel",
                        onClick: function () {
                            var dataGrid = $("#gridContainer").dxDataGrid("instance");
                            var workbook = new ExcelJS.Workbook();
                            var worksheet = workbook.addWorksheet("Attendance List");
                            DevExpress.excelExporter.exportDataGrid({
                                component: dataGrid,
                                worksheet: worksheet,
                                autoFilterEnabled: true
                            }).then(() => {
                                workbook.xlsx.writeBuffer().then((buffer) => {
                                    saveAs(new Blob([buffer], { type: "application/octet-stream" }), "Attendance_List.xlsx");
                                });
                            });
                        }
                    }
                }]
            },
            columns: [
                {
                    caption: "No", width: 50,
                    cellTemplate: function (container, options) {
                        container.text(options.rowIndex + 1);
                    }
                },
                { caption: "Date", dataField: "Date", dataType: "date" },
                { caption: "In Time", dataField: "InTime", dataType: "datetime" },
                { caption: "Out Time", dataField: "OutTime", dataType: "datetime" },
                { caption: "Total Working Hours", dataField: "TotalWorkingHours" }
            ]
        });
    });
</script>
