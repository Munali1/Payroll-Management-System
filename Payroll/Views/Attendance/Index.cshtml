@using Newtonsoft.Json
@using Payroll.Application.Services.ServiceInterface
@model IEnumerable<Payroll.Domain.Entities.Attendence>
@inject IEmployeeService employeeService

@{
    ViewData["Title"] = "Attendence List";
}

<div class="container mt-4">
    <h2 class="text-center">@ViewData["Title"]</h2>

    <div id="gridContainer"></div>

    <script>
        $(function(){
            var attendenceData = @Html.Raw(JsonConvert.SerializeObject(Model));
            $("#gridContainer").dxDataGrid({
                dataSource: attendenceData,
                keyExpr: "Date",
                columnAutoWidth: true,
                showBorders: true,
                filterRow: { visible: true },
                searchPanel: { visible: true, width: 240, placeholder: "Search..." },
                export: {
                    enabled: true,
                    fileName: "Grouped_Attendance_List",
                    allowExportSelectedData: true
                },
                toolbar: {
                    items: [
                        {
                            widget: "dxButton",
                            options: {
                                icon: "exportxlsx",
                                text: "Export to Excel",
                                onClick: function () {
                                    var dataGrid = $("#gridContainer").dxDataGrid("instance");
                                    var workbook = new ExcelJS.Workbook();
                                    var worksheet = workbook.addWorksheet("Attendance List");
                                    DevExpress.excelExporter.exportDataGrid({
                                        component: dataGrid,
                                        worksheet: worksheet,
                                        autoFilterEnabled: true
                                    }).then(() => {
                                        workbook.xlsx.writeBuffer().then((buffer) => {
                                            saveAs(new Blob([buffer], { type: "application/octet-stream" }), "Grouped_Attendance_List.xlsx");
                                        });
                                    });
                                }
                            }
                        }
                    ]
                },
                columns: [
                    {
                        caption: "No", width: 50,
                        cellTemplate: function (container, options) {
                            container.text(options.rowIndex + 1);
                        }
                    },
                    { caption: "Employee Name", dataField: "EmployeeName" },
                    { caption: "Date", dataField: "Date", dataType: "date" },
                    { caption: "In Time", dataField: "InTime", dataType: "datetime" },
                    { caption: "Out Time", dataField: "OutTime", dataType: "datetime" },
                    { caption: "Total Working Hours", dataField: "TotalWorkingHours", dataType: "number" }
                ]
            });
        });
    </script>
</div>
