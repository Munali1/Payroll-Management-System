@using Newtonsoft.Json
@model IEnumerable<Payroll.Domain.Entities.Department>

@{
    ViewData["Title"] = "Department List";
}

<div class="container mt-4">
    <h2 class="text-center">@ViewData["Title"]</h2>

    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-success mb-3">Add Department</a>
    }
   
    <div id="gridContainer"></div>

    <script>
        var departmentData = @Html.Raw(JsonConvert.SerializeObject(Model.Select((dep, index) => new
            {
                No = index + 1,
                Id = dep.DepartmentId,
                DepartmentName = dep.DepartmentName,
                DepartmentEmail = dep.DepartmentEmail,
                DepartmentDescription = dep.DepartmentDescription
            })));

        $(function () {
            $("#gridContainer").dxDataGrid({
                dataSource: departmentData,
                keyExpr: "Id",
                columnAutoWidth: true,
                showBorders: true,
                filterRow: { visible: true },
                searchPanel: { visible: true, width: 240, placeholder: "Search..." },
                export: {
                    enabled: true,
                    fileName: "Department_List",
                    allowExportSelectedData: true
                },
                               onExporting: function(e) {
            var workbook = new ExcelJS.Workbook();
            var worksheet = workbook.addWorksheet("Department List");

            DevExpress.excelExporter.exportDataGrid({
                component: e.component,
                worksheet: worksheet,
                autoFilterEnabled: true,
                customizeColumns: function(columns) {
                
                    const index = columns.findIndex(col => col.caption === "Actions");
                    if (index !== -1) {
                        columns.splice(index, 1); 
                    }
                }
            }).then(() => {
                workbook.xlsx.writeBuffer().then((buffer) => {
                    saveAs(new Blob([buffer], { type: "application/octet-stream" }), "Department_List.xlsx");
                });
            });

            e.cancel = true; 
    

                },
                toolbar: {
                    items: [
                        {
                            widget: "dxButton",
                            options: {
                                icon: "exportxlsx",
                                text: "Export to Excel",
                                onClick: function() {
                                    var dataGrid = $("#gridContainer").dxDataGrid("instance");
                                    var workbook = new ExcelJS.Workbook();
                                    var worksheet = workbook.addWorksheet("Department List");

                                    DevExpress.excelExporter.exportDataGrid({
                                        component: dataGrid,
                                        worksheet: worksheet,
                                        autoFilterEnabled: true
                                    }).then(() => {
                                        workbook.xlsx.writeBuffer().then((buffer) => {
                                            saveAs(new Blob([buffer], { type: "application/octet-stream" }), "Department_List.xlsx");
                                        });
                                    });
                                }
                            }
                        }
                    ]
                },
                columns: [
                    {
                       caption: "No", width: 50,
        cellTemplate: function (container, options) {
            container.text(options.rowIndex + 1);
        }},
                    { caption: "Department Name", dataField: "DepartmentName" },
                    { caption: "Department Email", dataField: "DepartmentEmail" },
                    { caption: "Department Description", dataField: "DepartmentDescription" },
                    {
                        caption: "Actions",
                        cellTemplate: function(container, options) {
                            var id = options.data.Id;
                            var isAdmin = @Json.Serialize(User.IsInRole("Admin")); 

                            var btnContainer = $("<div>").addClass("d-flex gap-2");

                       
                            if (isAdmin) {
                                $("<a>")
                                    .addClass("btn btn-outline-primary btn-sm")
                                    .attr("href", "/Department/Edit/" + id)
                                    .html('<i class="bi bi-pencil-square"></i> Edit')
                                    .appendTo(btnContainer);

                                $("<a>")
                                    .addClass("btn btn-danger btn-sm")
                                    .attr("href", "/Department/Delete/" + id)
                                    .html('<i class="bi bi-trash"></i> Delete')
                                    .on("click", function() {
                                        return confirm("Are you sure you want to delete this record?");
                                    })
                                    .appendTo(btnContainer);
                            }

                           
                            $("<a>")
                                .addClass("btn btn-outline-primary btn-sm")
                                .attr("href", "/Department/EmployeeList/" + id)
                                .html('<i class="bi bi-person-lines-fill"></i> View Employees')
                                .appendTo(btnContainer);

                            btnContainer.appendTo(container);
                        },
                        width: 250
                    }
                ]
            });
        });
    </script>
</div>
