@using Newtonsoft.Json
@model IEnumerable<Payroll.Domain.Entities.Employee>

@{
    ViewData["Title"] = "Employee List";
}

<div class="container mt-4">
    <h2 class="text-center">@ViewData["Title"]</h2>

    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-success mb-3">Add Employee</a>
    }

    <div id="gridContainer"></div>

    <script>
        var employeeData = @Html.Raw(JsonConvert.SerializeObject(Model.Select((emp, index) => new
            {
                No = index + 1,
                Id = emp.Id,
                EmployeeName = emp.ApplicationUser.FirstName +" "+emp.ApplicationUser.LastName,
                Email = emp.ApplicationUser.Email,
                Department = emp.DepartmentId,
                Designation = emp.Designation,
                EmployeeImage = emp.EmployeeImage
            })));

        $(function () {
            $("#gridContainer").dxDataGrid({
                dataSource: employeeData,
                keyExpr: "Id",
                columnAutoWidth: true,
                showBorders: true,
                rowAlternationEnabled: true,
                filterRow: { visible: true },
                searchPanel: { visible: true, width: 240, placeholder: "Search..." },
                paging: { pageSize: 10 },
                pager: {
                    showPageSizeSelector: true,
                    allowedPageSizes: [10, 20, 50],
                    showInfo: true
                },
                export: {
                    enabled: true,
                    fileName: "Employee_List",
                    allowExportSelectedData: true
                },
                onExporting: function(e) {
                    var workbook = new ExcelJS.Workbook();
                    var worksheet = workbook.addWorksheet("Employee List");

                    DevExpress.excelExporter.exportDataGrid({
                        component: e.component,
                        worksheet: worksheet,
                        autoFilterEnabled: true,
                        selectedColumnsOnly: true
                    }).then(() => {
                        workbook.xlsx.writeBuffer().then((buffer) => {
                            saveAs(new Blob([buffer], { type: "application/octet-stream" }), "Employee_List.xlsx");
                        });
                    });

                    e.cancel = true;
                },
                toolbar: {
                    items: [
                        {
                            widget: "dxButton",
                            options: {
                                icon: "exportxlsx",
                                text: "Export to Excel",
                                onClick: function() {
                                    var dataGrid = $("#gridContainer").dxDataGrid("instance");
                                    var workbook = new ExcelJS.Workbook();
                                    var worksheet = workbook.addWorksheet("Employee List");

                                    DevExpress.excelExporter.exportDataGrid({
                                        component: dataGrid,
                                        worksheet: worksheet,
                                        autoFilterEnabled: true
                                    }).then(() => {
                                        workbook.xlsx.writeBuffer().then((buffer) => {
                                            saveAs(new Blob([buffer], { type: "application/octet-stream" }), "Employee_List.xlsx");
                                        });
                                    });
                                }
                            }
                        }
                    ]
                },
                columns: [
                    { caption: "No", dataField: "No", width: 50 },
                    { caption: "Employee Name", dataField: "EmployeeName" },
                    { caption: "Email", dataField: "Email" },
                    { caption: "Department", dataField: "Department" },
                    { caption: "Designation", dataField: "Designation" },
                    {
                        caption: "Profile Image",
                        dataField: "EmployeeImage",
                        cellTemplate: function(container, options) {
                            var imageUrl = options.data.EmployeeImage ? "/Images/" + options.data.EmployeeImage : null;
                            if (imageUrl) {
                                $("<img>").attr("src", imageUrl)
                                    .attr("width", "50").attr("height", "50")
                                    .addClass("border")
                                    .appendTo(container);
                            } else {
                                $("<span>").text("No Image").appendTo(container);
                            }
                        },
                        width: 100
                    },
                    {
                        caption: "Actions",
                        cellTemplate: function(container, options) {
                            var id = options.data.Id;
                            var isAdmin = @Json.Serialize(User.IsInRole("Admin"));

                            var btnContainer = $("<div>").addClass("d-flex gap-2");

                            $("<a>")
                                .addClass("btn btn-info btn-sm")
                                .attr("href", "/Employee/Details/" + id)
                                .html('<i class="bi bi-eye"></i> Details')
                                .appendTo(btnContainer);

                            if (isAdmin) {
                                $("<a>")
                                    .addClass("btn btn-warning btn-sm")
                                    .attr("href", "/Employee/Edit/" + id)
                                    .html('<i class="bi bi-pencil-square"></i> Edit')
                                    .appendTo(btnContainer);

                                $("<a>")
                                    .addClass("btn btn-danger btn-sm")
                                    .attr("href", "/Employee/Delete/" + id)
                                    .html('<i class="bi bi-trash"></i> Delete')
                                    .on("click", function() {
                                        return confirm("Are you sure you want to delete this employee?");
                                    })
                                    .appendTo(btnContainer);
                            }

                            btnContainer.appendTo(container);
                        },
                        width: 250
                    }
                ]
            });
        });
    </script>
</div>
