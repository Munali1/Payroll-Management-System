@model IEnumerable<Payroll.Domain.Entities.Leave>
@using Newtonsoft.Json

@{
    ViewData["Title"] = "Leave Requests";
}

<div class="container mt-4">
   
    <h2 class="text-center">@ViewData["Title"]</h2>
    <a asp-controller="Leave" asp-action="RequestLeave" class="btn btn-primary">Apply for leave</a>
    <div id="leaveGridContainer"></div>

    <script>
      
        var leaveData = @Html.Raw(JsonConvert.SerializeObject(Model.Select((leave, index) => new
            {
                No = index + 1,
                Id = leave.Id,
                LeaveType = leave.LeaveType,
                LeaveDate = leave.LeaveDate.ToString("yyyy-MM-dd"),
                LeaveDuration = leave.LeaveDuration,
                Status = leave.Status
            })));


        $(function () {
            $("#leaveGridContainer").dxDataGrid({
                dataSource: leaveData,
                keyExpr: "Id",
                columnAutoWidth: true,
                showBorders: true,
                filterRow: { visible: true },
                searchPanel: { visible: true, width: 240, placeholder: "Search..." },
                paging: {
                    pageSize: 10
                },
                pager: {
                    showPageSizeSelector: true,
                    allowedPageSizes: [5, 10, 20],
                    showInfo: true
                },
                columns: [
                    {
                        caption: "No",
                        dataField: "No",
                        width: 50
                    },
                    {
                        caption: "Leave Type",
                        dataField: "LeaveType"
                    },
                    {
                        caption: "Leave Date",
                        dataField: "LeaveDate",
                        dataType: "date",
                        format: "shortDate"
                    },
                    {
                        caption: "Leave Duration",
                        dataField: "LeaveDuration"
                    },
                    {
                        caption: "Status",
                        dataField: "Status",
                        cellTemplate: function(container, options) {
                            let color = "";
                            switch ((options.value || "").toLowerCase()) {
                                case "approved": color = "green"; break;
                                case "rejected": color = "red"; break;
                                case "pending": color = "orange"; break;
                                default: color = "gray";
                            }

                            $("<span>")
                                .text(options.value)
                                .css({ color: color, fontWeight: "bold" })
                                .appendTo(container);
                        }
                    }
                ]
            });
        });
    </script>
</div>
