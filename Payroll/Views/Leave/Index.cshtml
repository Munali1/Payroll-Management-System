@using Newtonsoft.Json
@using Payroll.Application.Services.ServiceInterface
@model IEnumerable<Payroll.Domain.Entities.Leave>
@inject IEmployeeService employeeSevice
@{
    ViewData["Title"] = "Leave Requests";
    bool isHr = User.IsInRole("HR");
}

<div class="container mt-4">
    <h2 class="text-center">@ViewData["Title"]</h2>

    <div id="leaveGridContainer"></div>

    <script>
        var leaveData = @Html.Raw(JsonConvert.SerializeObject(Model.Select((leave, index) => new
            {
                No = index + 1,
                Id = leave.Id,
                EmployeeName = employeeSevice.getName(leave.Employee.UserId),
                LeaveType = leave.LeaveType,
                LeaveDate = leave.LeaveDate,
                LeaveDuration = leave.LeaveDuration,
                Status = leave.Status
            })));

        const isHr = @Html.Raw(JsonConvert.SerializeObject(isHr));

        $(function () {
            $("#leaveGridContainer").dxDataGrid({
                dataSource: leaveData,
                keyExpr: "Id",
                columnAutoWidth: true,
                showBorders: true,
                filterRow: { visible: true },
                searchPanel: { visible: true, width: 240, placeholder: "Search..." },
                export: {
                    enabled: true,
                    fileName: "Leave_Requests",
                    allowExportSelectedData: true
                },
                paging: {
                    pageSize: 10
                },
                pager: {
                    showPageSizeSelector: true,
                    allowedPageSizes: [5, 10, 20],
                    showInfo: true
                },
                onExporting: function(e) {
                    var workbook = new ExcelJS.Workbook();
                    var worksheet = workbook.addWorksheet("Leave Requests");

                    DevExpress.excelExporter.exportDataGrid({
                        component: e.component,
                        worksheet: worksheet,
                        autoFilterEnabled: true
                    }).then(() => {
                        workbook.xlsx.writeBuffer().then((buffer) => {
                            saveAs(new Blob([buffer], { type: "application/octet-stream" }), "Leave_Requests.xlsx");
                        });
                    });

                    e.cancel = true;
                },
                toolbar: {
                    items: [
                        {
                            widget: "dxButton",
                            options: {
                                icon: "exportxlsx",
                                text: "Export to Excel",
                                onClick: function() {
                                    var dataGrid = $("#leaveGridContainer").dxDataGrid("instance");
                                    var workbook = new ExcelJS.Workbook();
                                    var worksheet = workbook.addWorksheet("Leave Requests");

                                    DevExpress.excelExporter.exportDataGrid({
                                        component: dataGrid,
                                        worksheet: worksheet,
                                        autoFilterEnabled: true
                                    }).then(() => {
                                        workbook.xlsx.writeBuffer().then((buffer) => {
                                            saveAs(new Blob([buffer], { type: "application/octet-stream" }), "Leave_Requests.xlsx");
                                        });
                                    });
                                }
                            }
                        }
                    ]
                },
                columns: [
                    {
                        caption: "No",
                        dataField: "No",
                        width: 50
                    },
                    {
                        caption: "Employee Name",
                        dataField: "EmployeeName"
                    },
                    {
                        caption: "Leave Type",
                        dataField: "LeaveType"
                    },
                    {
                        caption: "Leave Date",
                        dataField: "LeaveDate",
                        dataType: "date",
                        format: "shortDate"
                    },
                    {
                        caption: "Leave Duration",
                        dataField: "LeaveDuration"
                    },
                    {
                        caption: "Status",
                        dataField: "Status",
                        cellTemplate: function(container, options) {
                            let color = "";
                            switch ((options.value || "").toLowerCase()) {
                                case "approved": color = "green"; break;
                                case "rejected": color = "red"; break;
                                case "pending": color = "orange"; break;
                                default: color = "gray";
                            }

                            $("<span>")
                                .text(options.value)
                                .css({ color: color, fontWeight: "bold" })
                                .appendTo(container);
                        }
                    },
                    {
                        caption: "Actions",
                        allowExporting: false,
                        width: 200,
                        cellTemplate: function(container, options) {
                            var id = options.data.Id;

                            if (!isHr) return;

                            var btnContainer = $("<div>").addClass("d-flex gap-2");

                            $("<a>")
                                .addClass("btn btn-success btn-sm")
                                .attr("href", "/Leave/ApproveLeave?id=" + id)
                                .text("Change Leave Status")
                                .appendTo(btnContainer);

                            btnContainer.appendTo(container);
                        }
                    }
                ]
            });
        });
    </script>
</div>
