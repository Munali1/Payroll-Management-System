@using Payroll.Application.Services.ServiceInterface
@model Payroll.Domain.Entities.Salary
@inject IEmployeeService employeeService
<div class="container">
    <h2</h2>
    <table class="table table-bordered">
        <tr>
            <th>Employee Name</th>
            <td>@employeeService.getName(Model.Employee.UserId)</td>
        </tr>
        <tr>
            <th>Salary Amount</th>
            <td>@Model.SalaryAmount</td>
        </tr>
        <tr>
            <th>Bonus</th>
            <td>@Model.Bonus</td>
        </tr>
        <tr>
            <th>Total Salary</th>
            <td>@Model.TotalSalary</td>
        </tr>
        <tr>
            <th>Payment Date</th>
            <td>@Model.PaymentDate.ToString("yyyy-MM-dd")</td>
        </tr>
    </table>
    @if(User.IsInRole("Employee")){
        <a asp-action="Index" asp-controller="Home" class="btn btn-secondary">Back to Home Page</a>
    }
    else if(User.IsInRole("HR")){
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    }
</div>
