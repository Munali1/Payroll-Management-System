<div class="container mt-3">
    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <i class="bi bi-people-fill display-4 text-primary"></i>
                    <h5 class="card-title">Manage Employees</h5>
                    <a asp-controller="Employee" asp-action="Index" class="btn btn-primary">Go</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <i class="bi bi-building display-4 text-success"></i>
                    <h5 class="card-title">Manage Departments</h5>
                    <a asp-controller="Department" asp-action="Index" class="btn btn-success">Go</a>
                </div>
            </div>
        </div>
        @if(User.IsInRole("HR")){
            <div class="col-md-4">
                <div class="card shadow-sm text-center">
                    <div class="card-body">
                        <i class="bi bi-cash-stack display-4 text-warning"></i>
                        <h5 class="card-title">Salary Management</h5>
                        <a asp-controller="Salary" asp-action="Index" class="btn btn-warning">Go</a>
                    </div>
                </div>
            </div>
        }
        <div class="col-md-4">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <i class="bi bi-calendar-check display-4 text-info"></i>
                    <h5 class="card-title">Attendance</h5>
                    <a asp-controller="Attendance" asp-action="Index" class="btn btn-info">View</a>
                </div>
            </div>
        </div>
        
    </div>
</div>
