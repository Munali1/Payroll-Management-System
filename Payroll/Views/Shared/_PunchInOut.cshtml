@using Payroll.Application.Services.ServiceInterface
@using System.Security.Claims

@inject IEmployeeService employeeService
@inject IAttendenceService attendenceService
@model Payroll.Domain.Entities.Attendence
@{
    string userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    int id = employeeService.getEmpId(userId);
}
<ul class="navbar-nav">
    @if (User.IsInRole("Employee"))
    {

        <li class="nav-item">
            @if (Model == null || Model.inTime == null)
            {
                <form asp-controller="Attendance" asp-action="PunchIn" asp-route-id="@id" method="post">
                    <button type="submit" class="btn btn-success">Punch In</button>
                </form>
            }
            else if (Model.outTime == null)
            {
                <form id="punchOutForm" asp-controller="Attendance" asp-action="PunchOut" asp-route-id="@id" method="post" onsubmit="showTotalWorkingHours(@id)">
                    <button id="PunchOut" type="submit" class="btn btn-danger">Punch Out</button>
                </form>
            }
        </li>
    }
</ul>
<script>
    function showTotalWorkingHours(empId) {
        $.ajax({
            url: '/Attendance/getTotalWorkingHours',
            type: 'GET',
            data: { empId: empId },
            success: function (data) {
                if (data.hours !== undefined && data.minutes !== undefined) {
                    $.notify(`You have worked for: ${data.hours} hours and ${data.minutes} minutes.`, {
                        className: "info",
                        position: "top center",
                        autoHideDelay: 5000
                    });
                } else {
                    $.notify('Error fetching total working hours.', {
                        className: "error",
                        position: "top center"
                    });
                }
            },
            error: function () {
                $.notify('An error occurred while fetching total working hours.', {
                    className: "error",
                    position: "top center"
                });
            }
        });
    }
</script>